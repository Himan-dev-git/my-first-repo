public without sharing class SquareDataMigrationService {

    /*
     * Catalog migration includes:
     *
     * - Parent Product -> Square ITEM
     * - Variant -> Square ITEM_VARIATION
     * - Existing Salesforce SKU -> Square SKU
     * - Square Pricebook price -> Square variation price
     * - Square Item and Variation IDs -> Salesforce
     * - One available parent-product image -> Square
     *
     * Batch scope must remain 1 because SquareCatalogService
     * enqueues one SquareCatalogImageQueueable per transaction.
     */
    public static Id backfillCatalog() {
        return Database.executeBatch(
            new SquareCatalogMigrationBatch(),
            1
        );
    }

    /*
     * Inventory must be run only after catalog migration finishes,
     * because inventory requires Square_Catalog_Variation_Id__c.
     */
    public static Id backfillInventory() {
        return Database.executeBatch(
            new SquareInventoryMigrationBatch(),
            25
        );
    }

    /*
     * Starts catalog migration.
     *
     * Inventory is not started simultaneously because it depends
     * on the catalog variation IDs generated by the catalog stage.
     */
    public static Id backfillAll() {
        return Database.executeBatch(
            new SquareCatalogMigrationBatch(true),
            1
        );
    }

    public class SquareDataMigrationException
        extends Exception {
    }
}